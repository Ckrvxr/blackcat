{
  "name": "blackcat-dark-reader-userscript",
  "version": "0.1.0-beta.1",
  "description": "A free, auditable Dark Reader userscript",
  "license": "MIT",
  "repository": "github:Ckrvxr/blackcat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/settings.test.mjs tests/metadata.test.mjs",
    "test:artifact": "node --test tests/artifact.test.mjs",
    "build": "node scripts/build.mjs",
    "verify:reproducible": "node scripts/verify-reproducible.mjs",
    "check": "pnpm test && pnpm build && pnpm test:artifact && pnpm verify:reproducible"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/chrome": "0.3.4",
    "rollup": "4.63.5",
    "terser": "5.51.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  }
}
